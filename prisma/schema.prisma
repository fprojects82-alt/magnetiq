generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// type: "MAGNET_SMALL" | "MAGNET_LARGE" | "EVENT_CARD"
model Product {
  id               String  @id @default(auto()) @map("_id") @db.ObjectId
  slug             String  @unique
  name             String
  type             String
  description      String
  price            Int
  compareAtPrice   Int?
  sampleImageUrl   String
  active           Boolean @default(true)
  sortOrder        Int     @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orderItems OrderItem[]
}

model Package {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  slug           String  @unique
  name           String
  description    String
  price          Int
  compareAtPrice Int?
  badge          String?
  composition    String
  sampleImageUrl String
  photoSlots     Int      @default(1)
  // "PRESSED" | "FLAT" | "STICKER" | "BOOKMARK" for print bundles; null for anything else (mixed gift sets etc.)
  line           String?
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orderItems OrderItem[]
}

model Offer {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  badgeText   String?
  active      Boolean   @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Coupon {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  code       String    @unique
  percent    Int
  active     Boolean   @default(true)
  expiresAt  DateTime?
  usageLimit Int?
  usedCount  Int       @default(0)
  createdAt  DateTime  @default(now())
}

// status: "PENDING" | "CONFIRMED" | "PRINTING" | "SHIPPED" | "DELIVERED" | "CANCELLED"
model Order {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber   String   @unique
  customerName  String
  phone         String
  address       String
  city          String
  notes         String?
  status        String   @default("PENDING")
  subtotal      Int
  discount      Int      @default(0)
  deliveryFee   Int      @default(0)
  total         Int
  paymentMethod String   @default("INSTAPAY")
  // InstaPay transfer screenshot the customer uploaded after ordering.
  paymentProofUrl String?
  // Set when the admin confirms the InstaPay payment was received.
  paidAt        DateTime?
  // Shipping zone id from src/lib/shipping.ts (fee is stored in deliveryFee).
  deliveryZone  String?
  couponCode    String?
  customerId    String?  @db.ObjectId
  customer      Customer? @relation(fields: [customerId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items OrderItem[]
}

model Customer {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String   @unique
  phone        String
  passwordHash String
  address      String?
  city         String?
  createdAt    DateTime @default(now())

  orders Order[]
}

model OrderItem {
  id               String  @id @default(auto()) @map("_id") @db.ObjectId
  orderId          String  @db.ObjectId
  order            Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String? @db.ObjectId
  product          Product? @relation(fields: [productId], references: [id])
  packageId        String? @db.ObjectId
  package          Package? @relation(fields: [packageId], references: [id])
  name             String
  size             String?
  quantity         Int     @default(1)
  unitPrice        Int
  uploadedImageUrls String
  customText       String?
}

model AdminUser {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  email        String @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// Single-row config document, always addressed by the literal id "singleton".
model Settings {
  id             String @id @map("_id") @default("singleton")
  whatsappNumber String
  instapayNumber String @default("")
  deliveryFee    Int
  // Bumped by src/lib/catalogSync.ts after it loads a new built-in catalog.
  // Optional so settings documents created before this field existed still load.
  catalogVersion Int?
  updatedAt      DateTime @updatedAt
}

// Event card enquiries: priced per request, so they are not cart orders.
// status: "NEW" | "CONTACTED" | "CONFIRMED" | "DONE" | "CANCELLED"
model CardRequest {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  customerName  String
  phone         String
  cardType      String
  cardCount     Int
  withMagnets   Boolean  @default(false)
  magnetType    String?
  magnetCount   Int?
  names         String?
  eventDate     String?
  notes         String?
  demoImageUrls String   @default("[]")
  status        String   @default("NEW")
  createdAt     DateTime @default(now())
}

// Customer photos, stored in the database when Vercel Blob is not connected.
// Served by /api/uploads/[id]. Photos are resized in the browser first (~0.2–1 MB).
model Upload {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  data        Bytes
  contentType String
  size        Int
  createdAt   DateTime @default(now())
}

// Customer reviews. Only orders with a confirmed payment can leave one (one per
// order). Shown on the home page unless an admin hides it.
model Review {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber String   @unique
  name        String
  rating      Int
  text        String
  photoUrl    String?
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
}
